{
  "name": "fieldops-backend",
  "version": "0.1.0",
  "private": true,
  "description": "FieldOps SMKMC REST API - NestJS modular monolith",
  "license": "UNLICENSED",
  "engines": {
    "node": ">=18.18"
  },
  "scripts": {
    "build": "nest build",
    "start:dev": "cross-env NODE_ENV=development nest start --watch",
    "start:test": "cross-env NODE_ENV=test node dist/main",
    "start:prod": "cross-env NODE_ENV=production node dist/main",
    "lint": "eslint \"src/**/*.ts\" \"test/**/*.ts\"",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "test": "cross-env NODE_ENV=test jest",
    "test:watch": "cross-env NODE_ENV=test jest --watch",
    "test:cov": "cross-env NODE_ENV=test jest --coverage",
    "test:e2e": "cross-env NODE_ENV=test jest --config ./test/jest-e2e.json --runInBand --forceExit",
    "migration:run": "typeorm -d dist/shared/database/data-source.js migration:run",
    "migration:revert": "typeorm -d dist/shared/database/data-source.js migration:revert",
    "migration:show": "typeorm -d dist/shared/database/data-source.js migration:show",
    "db:migrate:dev": "npm run build && cross-env NODE_ENV=development npm run migration:run",
    "db:migrate:test": "npm run build && cross-env NODE_ENV=test npm run migration:run",
    "db:seed:dev": "npm run build && cross-env NODE_ENV=development node dist/database/seed/run-seed.js",
    "db:seed:test": "npm run build && cross-env NODE_ENV=test node dist/database/seed/run-seed.js",
    "db:seed:pilot": "npm run build && cross-env NODE_ENV=development node dist/database/seed/run-pilot.js",
    "openapi:export": "cross-env NODE_ENV=development node dist/openapi/export-openapi.js"
  },
  "dependencies": {
    "@nestjs/common": "^10.4.15",
    "@nestjs/config": "^3.3.0",
    "@nestjs/core": "^10.4.15",
    "@nestjs/jwt": "^10.2.0",
    "@nestjs/platform-express": "^10.4.15",
    "@nestjs/schedule": "^4.1.2",
    "@nestjs/swagger": "^8.1.0",
    "@nestjs/throttler": "^6.2.1",
    "@nestjs/typeorm": "^10.0.2",
    "bcryptjs": "^2.4.3",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "cross-env": "^7.0.3",
    "dotenv": "^16.4.7",
    "fast-xml-parser": "^4.5.1",
    "helmet": "^8.0.0",
    "joi": "^17.13.3",
    "jpeg-js": "^0.4.4",
    "nestjs-pino": "^4.1.0",
    "onnxruntime-node": "^1.31.1",
    "oracledb": "^6.7.0",
    "pdfkit": "^0.15.2",
    "pg": "^8.13.1",
    "pino": "^9.5.0",
    "pino-http": "^10.3.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "typeorm": "^0.3.20",
    "xml-crypto": "^6.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@nestjs/cli": "^10.4.9",
    "@nestjs/testing": "^10.4.15",
    "@types/bcryptjs": "^2.4.6",
    "@types/express": "^4.17.21",
    "@types/jest": "^29.5.14",
    "@types/multer": "^1.4.12",
    "@types/node": "^20.17.10",
    "@types/pdfkit": "^0.13.9",
    "@types/pg": "^8.11.10",
    "@types/supertest": "^6.0.2",
    "eslint": "^9.17.0",
    "jest": "^29.7.0",
    "pino-pretty": "^13.0.0",
    "prettier": "^3.4.2",
    "source-map-support": "^0.5.21",
    "supertest": "^7.0.0",
    "ts-jest": "^29.2.5",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.18.1"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": "src",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": "ts-jest"
    },
    "collectCoverageFrom": [
      "**/*.ts",
      "!**/*.module.ts",
      "!main.ts",
      "!database/migrations/**"
    ],
    "coverageDirectory": "../coverage",
    "testEnvironment": "node",
    "setupFiles": [
      "<rootDir>/../test/setup-env.ts"
    ]
  }
}
