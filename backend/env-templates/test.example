# FieldOps backend - TEST settings (unit + e2e tests).
# Copy to backend/.env.test (git-ignored). Uses a separate database that tests may wipe.
NODE_ENV=test
PORT=3100
LOG_LEVEL=warn
CORS_ORIGINS=http://localhost:3001
SWAGGER_ENABLED=true

DB_TYPE=postgres
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=fieldops
DB_PASSWORD=change-me-local
DB_NAME=fieldops_test
DB_POOL_MAX=5
DB_SLOW_QUERY_MS=500
DB_SSL=false

AUTH_TEST_LOGIN_ENABLED=true

JWT_ACCESS_SECRET=test-only-access-secret-change-me
JWT_REFRESH_SECRET=test-only-refresh-secret-change-me

# Sign-in. Access tokens are short; refresh tokens rotate on every use.
JWT_ACCESS_TTL_SECONDS=900
AUTH_REFRESH_TTL_DAYS=30
AUTH_MAX_SESSIONS_PER_STAFF=5
# OTP delivery: log (prints codes to this console - dev/test only), sms_http, or disabled.
OTP_SENDER=log
OTP_TTL_SECONDS=300
OTP_MAX_ATTEMPTS=5
OTP_MAX_PER_15_MIN=3
# Requests per minute (per signed-in user, else per IP); sign-in endpoints per IP.
RATE_LIMIT_PER_MINUTE=100000
SIGN_IN_RATE_LIMIT_PER_MINUTE=100000
TRUST_PROXY=false

# Scheduled jobs: auto-checkout, silent-gap detection, nightly roll-ups, retention purge.
# Safe on every PM2 instance: a database lock makes each run happen once. Off in tests,
# which call the jobs directly with a frozen clock.
JOBS_ENABLED=false
# How long raw location pings are kept (SMKC policy); daily route summaries stay.
PING_RETENTION_DAYS=90

# Mobile app versions (Android versionCode): below the minimum the app must update first.
MOBILE_MIN_VERSION_CODE=1
MOBILE_LATEST_VERSION_CODE=1
# Where the update is downloaded from (Play Store or SMKC's own page); optional.
# MOBILE_UPDATE_URL=

# Uploaded photos (task evidence) stay on this server. Relative paths are from backend/.
UPLOAD_DIR=storage/test-uploads
UPLOAD_MAX_BYTES=2000000

# Notifications. The in-app inbox (polled by the app) always works; these add channels.
# Firebase Cloud Messaging push (service account; all three or none). Payloads carry no
# personal data, only "open the app" hints.
# FCM_PROJECT_ID=
# FCM_CLIENT_EMAIL=
# FCM_PRIVATE_KEY=
# SMS / WhatsApp through SMKC's gateway (JSON POST {to, text}); off unless set.
# NOTIFY_SMS_URL=
# NOTIFY_WHATSAPP_URL=
# NOTIFY_GATEWAY_TOKEN=

# Share of checked-in field staff who get one random spot check per shift (0 = off).
SPOT_CHECK_DAILY_RATE=0
# Inspector proxy punches must scan the worker's rolling QR code (a code sent is always checked).
COPRESENCE_REQUIRED=false

# How each worker's shift times turn into marks: on time up to the grace, late after it, a
# half day past this share of the shift (no check-in by then shows as absent until they arrive).
ATTENDANCE_LATE_GRACE_MINUTES=15
ATTENDANCE_HALF_DAY_AFTER_PERCENT=50

# Offline map tiles for the SMKMC area (z/x/y.png + manifest.json, built from OSM data;
# see backend/README.md). Unset: clients use the public OSM tile server.
# TILE_DIR=storage/tiles

# Sample seed only (npm run db:seed:dev): password for the web roles (admin, office staff,
# ward inspectors), 10+ characters with letters and digits. Leave empty for no password.
# Refused in production.
SEED_WEB_PASSWORD=

# Face verification: local (AuraFace on our server, default) or aadhaar (UIDAI via SMKC's ASA).
FACE_PROVIDER=local
FACE_MATCH_THRESHOLD=0.45
FACE_LIVENESS_THRESHOLD=0.5
# Folder holding the three face models (see modules/face/README.md); at most FACE_MAX_PARALLEL
# analyses run together, each model using FACE_THREADS CPU threads.
FACE_MODEL_DIR=storage/models
FACE_MAX_PARALLEL=2
FACE_THREADS=2
# Only when FACE_PROVIDER=aadhaar (values issued to SMKC by UIDAI / its ASA):
# AADHAAR_ENV=PP                      # PP pre-production, P production
# AADHAAR_API_VERSION=2.5
# AADHAAR_PID_VERSION=2.0
# AADHAAR_LANGUAGE=mr
# AADHAAR_AUA_CODE=
# AADHAAR_SUB_AUA_CODE=
# AADHAAR_LICENSE_KEY=
# AADHAAR_ASA_LICENSE_KEY=
# AADHAAR_ASA_URL_TEMPLATE=https://<asa-host>/{ver}/{ac}/{uid0}/{uid1}/{asalk}
# AADHAAR_SIGNING_KEY_PATH=C:\fieldops\keys\aua-signing.key
# AADHAAR_SIGNING_CERT_PATH=C:\fieldops\keys\aua-signing.crt
# AADHAAR_TIMEOUT_MS=15000
